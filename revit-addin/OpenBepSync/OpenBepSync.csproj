<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build for one Revit version at a time:
      dotnet build -c Release -p:RevitVersion=2025
    Revit 2025 and later run on .NET 8; Revit 2024 runs on .NET Framework 4.8.
    RevitAPI.dll and RevitAPIUI.dll are referenced from the local Revit install and not copied.
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <RevitDir>C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitDir>
    <TargetFramework Condition="'$(RevitVersion)' &gt;= '2025'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &lt; '2025'">net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>OpenBepSync</AssemblyName>
    <RootNamespace>OpenBepSync</RootNamespace>
    <Version>0.1.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <OutputPath>bin\$(Configuration)\Revit$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>$(RevitDir)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitDir)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Update="OpenBepSync.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
